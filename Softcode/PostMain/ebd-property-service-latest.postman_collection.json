{
  "info": {
    "name": "EBD - Property Service",
    "description": "Generated from the latest uploaded property-service. Collection-level Bearer authentication uses {{accessToken}}. Base URL uses {{propertyBaseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "propertyBaseUrl",
      "value": "http://localhost:8068",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "ownerId",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "propertyId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Create Property",
      "item": [
        {
          "name": "Create Restaurant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{propertyBaseUrl}}/api/v1/properties",
              "host": [
                "{{propertyBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "properties"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerId\": \"{{ownerId}}\",\n  \"name\": \"Piseth Garden Restaurant\",\n  \"businessType\": \"RESTAURANT\",\n  \"description\": \"Restaurant property for Enterprise Backend Development demo.\",\n  \"phoneNumber\": \"012345678\",\n  \"email\": \"restaurant@example.com\",\n  \"telegram\": \"@pisethrestaurant\",\n  \"facebookPage\": \"Piseth Garden Restaurant\",\n  \"provinceCode\": \"12\",\n  \"districtCode\": \"1201\",\n  \"communeCode\": \"120101\",\n  \"villageCode\": \"12010101\",\n  \"streetAddress\": \"Phnom Penh\",\n  \"latitude\": 11.5564,\n  \"longitude\": 104.9282,\n  \"thumbnailMediaId\": null,\n  \"galleryMediaIds\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.id) {",
                  "    pm.collectionVariables.set(\"propertyId\", body.id);",
                  "}"
                ]
              }
            }
          ]
        },
