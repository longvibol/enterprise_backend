{
  "info": {
    "_postman_id": "7dbdf730-262a-4c0e-beb5-1c43d18f4ba8",
    "name": "Enterprise Backend Development - User Service",
    "description": "Postman collection for the Restaurant and KTV User Service.\n\nDefault base URL: http://localhost:8089\n\nRecommended flow:\n1. Register a business owner or create a platform staff account.\n2. Login.\n3. The login test script automatically stores accessToken and refreshToken.\n4. Run authenticated user-management requests.\n\nThe current service temporarily permits /api/v1/platform-staff/** without authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({",
          "    key: 'X-Request-Id',",
          "    value: pm.variables.replaceIn('{{$guid}}')",
          "});"
        ]
      }
    }
  ],
